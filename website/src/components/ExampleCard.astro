---
import type { ExtensionExample } from '../data/extensionExamples';
import StatusLabel from './StatusLabel.astro';

interface Props { example: ExtensionExample; }
const { example } = Astro.props;
const sourceBase = 'https://github.com/ashwin-pc/pi-web/blob/main/examples/pi-web-extensions';
const command = `mkdir -p .pi/web/extensions && cp examples/pi-web-extensions/${example.file} .pi/web/extensions/`;
---

<article class="example-card" id={example.id}>
  <div class="example-card__header"><StatusLabel status={example.status} /><span>{example.surface}</span></div>
  <h2>{example.title}</h2>
  <p class="example-card__outcome">{example.outcome}</p>
  {example.note && <p class="example-card__note">{example.note}</p>}
  <details class="install-details">
    <summary>Copy from a checkout</summary>
    <pre><code>{command}{'\n/reload'}</code></pre>
  </details>
  <div class="adapt-prompt"><strong>Ask your agent</strong><p>“{example.adaptPrompt}”</p></div>
  <a class="example-card__source" href={`${sourceBase}/${example.file}`}>Source ↗</a>
</article>
