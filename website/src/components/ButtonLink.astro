---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;
---

<a
  class:list={['button-link', `button-link--${variant}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
>
  <slot />
  <span aria-hidden="true" class="button-link__arrow">{external ? '↗' : '→'}</span>
</a>
