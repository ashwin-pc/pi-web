---
interface Props {
  desktop: string;
  mobile: string;
  desktopWidth: number;
  desktopHeight?: number;
  alt: string;
  caption: string;
}

const { desktop, mobile, desktopWidth, desktopHeight = 1000, alt, caption } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<figure class="capture-pair" style={`--capture-ratio: ${desktopWidth} / ${desktopHeight}; --capture-mobile-ratio: 393 / 727`}>
  <picture>
    <source media="(max-width: 600px)" srcset={`${base}generated/${mobile}`} width="393" height="727" />
    <img src={`${base}generated/${desktop}`} width={desktopWidth} height={desktopHeight} alt={alt} loading="lazy" decoding="async" />
  </picture>
  <figcaption>{caption}</figcaption>
</figure>
