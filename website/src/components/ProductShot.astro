---
interface Props {
  variant?: 'workspace' | 'first-run';
  caption?: string;
}

const {
  variant = 'workspace',
  caption = 'A representative composition of the pi-web workspace—not a live demo.',
} = Astro.props;
---

<figure class="product-shot">
  <div class="product-shot__glow" aria-hidden="true"></div>
  <div class="product-frame" aria-hidden="true">
    <div class="product-frame__bar">
      <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="product-frame__tabs">
        <span class="product-frame__tab product-frame__tab--active">Launch brief</span>
        <span class="product-frame__tab"><i class="running-dot"></i> Research</span>
        <span class="product-frame__tab">Fact check</span>
      </div>
      <span class="product-frame__status">pi-web</span>
    </div>

    <div class:list={['product-frame__body', { 'product-frame__body--first-run': variant === 'first-run' }]}>
      {variant === 'workspace' ? (
        <>
          <aside class="session-rail" aria-hidden="true">
            <p>WORKSPACE</p>
            <strong>Launch planning</strong>
            <ul>
              <li class="active"><span>01</span> Draft launch brief</li>
              <li><span class="pulse"></span> Synthesize interviews</li>
              <li><span>03</span> Check market claims</li>
            </ul>
            <p>BOOKMARKS</p>
            <ul><li><span>↗</span> Source library</li></ul>
          </aside>
          <div class="transcript-preview">
            <div class="thread-meta"><span>Draft launch brief</span><span>● Complete</span></div>
            <p class="user-prompt">Turn the customer notes into a clear launch brief and a visual summary.</p>
            <div class="tool-result"><span class="tool-result__icon">✓</span><span><strong>Read 18 interview notes</strong><small>Evidence grouped into four themes</small></span><span>0:12</span></div>
            <div class="agent-result">
              <span class="agent-result__avatar">π</span>
              <div>
                <p class="agent-result__label">RESULT</p>
                <h3>Launch brief is ready</h3>
                <p>I shaped the evidence into a concise narrative, kept uncertain claims visible, and prepared the handoff files.</p>
                <div class="artifact-row">
                  <div><span class="artifact-icon">▤</span><span><strong>Launch brief</strong><small>Markdown · 12 KB</small></span></div>
                  <div><span class="artifact-icon artifact-icon--warm">◇</span><span><strong>Visual summary</strong><small>Interactive HTML</small></span></div>
                </div>
              </div>
            </div>
          </div>
        </>
      ) : (
        <div class="first-run-preview">
          <span class="first-run-preview__mark">π</span>
          <p class="eyebrow">New session</p>
          <h3>What should your agent work on?</h3>
          <p>pi is connected and ready in your chosen working directory.</p>
          <div class="cwd-pill"><span>⌂</span><code>/workspace/launch-plan</code><span>⌄</span></div>
          <div class="composer-preview"><span>Describe meaningful work…</span><strong aria-hidden="true">↑</strong></div>
        </div>
      )}
    </div>
  </div>
  <figcaption>{caption}</figcaption>
</figure>
