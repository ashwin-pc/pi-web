---
import FeaturePage from '../../../components/FeaturePage.astro';
import ProductStory from '../../../components/ProductStory.astro';
import Section from '../../../components/Section.astro';
import { getFeatureRoute } from '../../../data/features';

const base = import.meta.env.BASE_URL;
const feature = getFeatureRoute('work-from-anywhere');
const repo = 'https://github.com/ashwin-pc/pi-web';
---

<FeaturePage feature={feature} description="Use pi-web's responsive agent workspace across devices with user-managed remote access." primary={{ label: 'Set up pi-web', href: `${base}getting-started/` }} secondary={{ label: 'Keep the thread', href: `${base}features/keep-the-thread/` }} technicalLinks={[{ label: 'Remote access', href: `${repo}#remote-access` }, { label: 'Security', href: `${repo}#security` }, { label: 'PWA configuration', href: `${repo}/blob/main/vite.config.ts` }]}>
  <Section eyebrow="Responsive by design" title="Start here. Return from anywhere.">
    <div class="story-stack">
      <ProductStory desktop="new-session-desktop.png" mobile="new-session-mobile.png" width={1280} height={800} alt="New pi-web session on desktop and mobile" title="One workspace" caption="New session, adapted to each screen." />
      <ProductStory desktop="artifacts-explorer-desktop.png" mobile="artifacts-explorer-mobile.png" width={1600} height={1000} alt="Artifacts gallery on desktop and mobile" title="The result travels too" caption="Artifacts remain browsable on a phone." />
    </div>
  </Section>
  <Section tone="dark" narrow eyebrow="Access boundary" title="You choose the network.">
    <p class="boundary-copy">pi-web starts on localhost. Use Tailscale or an HTTPS proxy you operate, with the optional bearer token as one layer. pi-web provides no hosted relay or identity service.</p>
  </Section>
</FeaturePage>
