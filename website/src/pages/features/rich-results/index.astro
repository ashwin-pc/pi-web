---
import FeaturePage from '../../../components/FeaturePage.astro';
import ProductStory from '../../../components/ProductStory.astro';
import Section from '../../../components/Section.astro';
import { getFeatureRoute } from '../../../data/features';

const base = import.meta.env.BASE_URL;
const feature = getFeatureRoute('rich-results');
const repo = 'https://github.com/ashwin-pc/pi-web';
---

<FeaturePage feature={feature} description="Turn agent work into inspectable transcripts, tool activity, previews, and browsable artifacts." primary={{ label: 'Get started', href: `${base}getting-started/` }} secondary={{ label: 'Add an artifact workflow', href: `${base}extensions/` }} technicalLinks={[{ label: 'Rich response guidance', href: `${repo}/blob/main/contexts/web-ui.md#rich-visual-responses` }, { label: 'Artifact browser source', href: `${repo}/blob/main/src/files/artifactBrowser.ts` }, { label: 'Artifact tests', href: `${repo}/blob/main/tests/e2e/files.spec.ts` }]}>
  <Section eyebrow="Gallery to preview" title="Find the handoff. Open the result.">
    <div class="story-stack">
      <ProductStory desktop="artifacts-explorer-desktop.png" mobile="artifacts-explorer-mobile.png" width={1600} height={1000} alt="Artifacts gallery containing folders, image, HTML, Markdown, and video results" title="Browse deliverables" caption="Folders, HTML, images, Markdown, video, and more." />
      <ProductStory desktop="artifact-preview-desktop.png" mobile="artifact-preview-mobile.png" width={1600} height={1000} alt="Interactive HTML artifact preview with open and download controls" title="Inspect the result" caption="A sandboxed interactive HTML artifact with open and download controls." />
    </div>
  </Section>
  <Section tone="dark" narrow eyebrow="Rendering boundary" title="Rich output, contained.">
    <p class="boundary-copy">Markdown is sanitized and agent-produced HTML is sandboxed. The current default and full-capability reference harness is <code>pi</code>.</p>
  </Section>
</FeaturePage>
