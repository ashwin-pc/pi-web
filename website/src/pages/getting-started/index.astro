---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import ProductStory from '../../components/ProductStory.astro';
import Section from '../../components/Section.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Getting started" description="Install pi-web, connect pi to a model provider, and start your first local agent session. Node.js 24+ required.">
  <section class="page-hero">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow">Getting started</p>
        <h1>From install to your first agent session.</h1>
        <p class="page-hero__lede">Run pi-web in the folder where work should happen.</p>
        <InstallCommand label="Node.js 24+" />
      </div>
      <ProductStory
        desktop="new-session-desktop.png"
        mobile="new-session-mobile.png"
        width={1280}
        height={800}
        mobileWidth={1081}
        mobileHeight={1999}
        mobileAspectWidth={393}
        mobileAspectHeight={727}
        alt="New pi-web session with working directory and prompt composer"
        caption="A new session in the real responsive pi-web interface."
        priority
        size="card"
      />
    </div>
  </section>

  <Section narrow eyebrow="Three commands" title="Install. Connect. Work.">
    <div class="command-guide">
      <article id="install"><span>01</span><div><h2>Start in your workspace</h2><InstallCommand compact /><p>Or set <code>PI_WEB_CWD=/path/to/workspace</code>.</p></div></article>
      <article id="provider"><span>02</span><div><h2>Connect a provider</h2><pre><code>/login</code></pre><p>If prompted, pi-web opens the bundled <code>pi</code> CLI. Log in, exit, and startup continues.</p></div></article>
      <article id="open"><span>03</span><div><h2>Open the workspace</h2><pre><code>http://127.0.0.1:8787</code></pre><p>Give the first session a bounded task, then inspect its tools, files, or artifacts.</p></div></article>
    </div>
    <p class="setup-boundary">There is no hosted account or relay in this setup. pi-web runs with your local projects and credentials.</p>
  </Section>

  <Section id="remote-access" tone="dark" narrow eyebrow="Optional remote access" title="Bring your own secure path.">
    <div class="remote-compact">
      <InstallCommand command={'PI_WEB_TOKEN="$(openssl rand -hex 32)" npx -y @ashwin-pc/pi-web@latest'} label="Optional bearer token" compact />
      <p>Use Tailscale or an HTTPS reverse proxy you control. A bearer token protects app requests; it does not replace transport security.</p>
      <div class="inline-links"><a href="https://github.com/ashwin-pc/pi-web#remote-access">Remote access guide ↗</a><a href="https://github.com/ashwin-pc/pi-web#security">Security notes ↗</a></div>
    </div>
  </Section>

  <section class="closing-cta"><div class="container closing-cta__inner"><div><p class="eyebrow">Ready?</p><h2>Run it where the work lives.</h2></div><ButtonLink href={`${base}features/`} variant="secondary">See what it can do</ButtonLink></div></section>
</BaseLayout>
