---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BottomCTA from '../../components/BottomCTA.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import MarketingHero from '../../components/MarketingHero.astro';
import ProductStory from '../../components/ProductStory.astro';
import Section from '../../components/Section.astro';
import { recommendedExamples } from '../../data/extensionExamples';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/ashwin-pc/pi-web';
const docs = `${repo}/blob/main/docs/pi-web-extensions.md`;
---

<BaseLayout title="Extensions and add-ons" description="Enhance pi-web with recommended add-ons, adapt trusted TypeScript templates, or build a project-local workflow.">
  <MarketingHero eyebrow="Optional trusted code" title="Describe the workflow. Ask your agent to add it." lede="Core pi-web works without extensions. For more, choose a recommended add-on, adapt a template, or write source you can inspect, reload, and refine.">
    <ButtonLink href={`${base}extensions/examples/#recommended`}>Recommended add-ons</ButtonLink>
    <ButtonLink href={docs} external variant="secondary">Extension API</ButtonLink>
  </MarketingHero>

  <Section eyebrow="A real extension" title="The workflow appears inside pi-web.">
    <ProductStory
      desktop="website-extension-desktop.png"
      mobile="website-extension-mobile.png"
      width={1440}
      height={1000}
      mobileWidth={1073}
      mobileHeight={2321}
      mobileAspectWidth={390}
      mobileAspectHeight={844}
      alt="A launch decisions extension open in pi-web beside its source session"
      caption="A project workflow rendered through pi-web’s real extension contribution API."
      href={`${repo}/blob/main/server/fixtures/websiteWorkflowExtension.ts`}
      linkLabel="View its source"
      priority
    />
  </Section>

  <Section id="recommended" tone="tinted" eyebrow="Recommended add-ons" title="Useful enhancements, not required core.">
    <p class="boundary-copy">The GitHub repository panel, global notepad, recap action, artifact reference, and live Git footer are the recommended starting set for a richer-than-minimal setup. They remain optional trusted source: choose, inspect, copy, and adapt only what you need.</p>
    <div class="source-example-row">
      {recommendedExamples.map((example) => <a href={`${base}extensions/examples/#${example.id}`}><strong>{example.title}</strong><span>Review the add-on →</span></a>)}
    </div>
  </Section>

  <Section id="build-your-own" eyebrow="Templates · build your own" title="Ask → write → reload.">
    <div class="agent-sequence">
      <div><span>Ask</span><blockquote>“Read <code>docs/pi-web-extensions.md</code>. Add a project-local panel for this workflow.”</blockquote></div>
      <div><span>Write</span><pre><code>.pi/web/extensions/my-workflow.ts</code></pre></div>
      <div><span>Use</span><pre><code>/reload</code></pre></div>
    </div>
    <p class="boundary-copy extension-sequence-note">Examples are templates, not an installer: start from a checkout, copy the closest file, inspect and edit it, then use <code>/reload</code>.</p>
  </Section>

  <Section tone="tinted" eyebrow="Choose the scope" title="Shared agent behavior or browser UI?">
    <div class="scope-row">
      <article><code>.pi/extensions/*.ts</code><strong>Regular <code>pi</code> extension</strong><span>Tools, commands, prompts, events.</span></article>
      <article><code>.pi/web/extensions/*.ts</code><strong>pi-web extension</strong><span>Panels, actions, tabs, settings.</span></article>
    </div>
    <p class="boundary-copy">Both currently run through <code>pi</code>'s extension runtime. Project-local or global source is trusted local code: read it before reloading.</p>
  </Section>

  <Section tone="tinted" narrow eyebrow="Settings and recovery" title="Keep the extension observable.">
    <p class="boundary-copy">Extensions can contribute settings alongside panels and actions. pi-web surfaces extension, skill, and prompt diagnostics so local source problems are visible; use <code>/reload</code> to refresh pi resources, extensions, skills, prompts, and models after a change.</p>
  </Section>

  <Section id="api" tone="dark" narrow eyebrow="Supported surfaces" title="Add only what the workflow needs.">
    <div class="surface-list"><span>Footer</span><span>Header action</span><span>Artifact action</span><span>Git tab</span><span>Right panel</span><span>FAB</span><span>Settings</span></div>
    <p class="boundary-copy">Harness-neutral add-ons are design direction, not something available extensions can target today.</p>
  </Section>

  <BottomCTA eyebrow="Working source" title="Start from an add-on or template. Make it yours." primaryHref={`${base}extensions/examples/`} primaryLabel="Browse add-ons and templates" secondaryHref={docs} secondaryLabel="Read the API" />
</BaseLayout>
