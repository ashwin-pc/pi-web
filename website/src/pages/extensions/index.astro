---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BottomCTA from '../../components/BottomCTA.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import MarketingHero from '../../components/MarketingHero.astro';
import ProductStory from '../../components/ProductStory.astro';
import Section from '../../components/Section.astro';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/ashwin-pc/pi-web';
const docs = `${repo}/blob/main/docs/pi-web-extensions.md`;
---

<BaseLayout title="Extensions" description="Ask your agent to add a project-local pi-web workflow as trusted TypeScript source.">
  <MarketingHero eyebrow="Extensions" title="Describe the workflow. Ask your agent to add it." lede="A request becomes source you can inspect, reload, and refine.">
    <ButtonLink href={`${base}extensions/examples/`}>Try an example</ButtonLink>
    <ButtonLink href={docs} external variant="secondary">Extension API</ButtonLink>
  </MarketingHero>

  <Section eyebrow="A real extension" title="The workflow appears inside pi-web.">
    <ProductStory
      desktop="website-extension-desktop.png"
      mobile="website-extension-mobile.png"
      width={1440}
      height={1000}
      mobileWidth={1073}
      mobileHeight={2321}
      mobileAspectWidth={390}
      mobileAspectHeight={844}
      alt="A launch decisions extension open in pi-web beside its source session"
      caption="A project workflow rendered through pi-web’s real extension contribution API."
      href={`${repo}/blob/main/server/fixtures/websiteWorkflowExtension.ts`}
      linkLabel="View its source"
      priority
    />
  </Section>

  <Section tone="tinted" eyebrow="The workflow" title="Ask → write → reload.">
    <div class="agent-sequence">
      <div><span>Ask</span><blockquote>“Read <code>docs/pi-web-extensions.md</code>. Add a project-local panel for this workflow.”</blockquote></div>
      <div><span>Write</span><pre><code>.pi/web/extensions/my-workflow.ts</code></pre></div>
      <div><span>Use</span><pre><code>/reload</code></pre></div>
    </div>
    <div class="source-example-row">
      <a href={`${repo}/blob/main/examples/pi-web-extensions/notepad.ts`}><strong>Notepad panel</strong><span>Actual source ↗</span></a>
      <a href={`${repo}/blob/main/examples/pi-web-extensions/github-repo-panel.ts`}><strong>GitHub tab</strong><span>Actual source ↗</span></a>
      <a href={`${repo}/blob/main/examples/pi-web-extensions/download-artifact.ts`}><strong>Artifact action</strong><span>Actual source ↗</span></a>
    </div>
  </Section>

  <Section eyebrow="Choose the scope" title="Shared agent behavior or browser UI?">
    <div class="scope-row">
      <article><code>.pi/extensions/*.ts</code><strong>Regular <code>pi</code> extension</strong><span>Tools, commands, prompts, events.</span></article>
      <article><code>.pi/web/extensions/*.ts</code><strong>pi-web extension</strong><span>Panels, actions, tabs, settings.</span></article>
    </div>
    <p class="boundary-copy">Both currently run through <code>pi</code>'s extension runtime. Project-local or global source is trusted local code: read it before reloading.</p>
  </Section>

  <Section id="api" tone="dark" narrow eyebrow="Supported surfaces" title="Add only what the workflow needs.">
    <div class="surface-list"><span>Footer</span><span>Header action</span><span>Artifact action</span><span>Git tab</span><span>Right panel</span><span>FAB</span><span>Settings</span></div>
    <p class="boundary-copy">Harness-neutral add-ons are design direction, not something available extensions can target today.</p>
  </Section>

  <BottomCTA eyebrow="Working source" title="Start from an example. Make it yours." primaryHref={`${base}extensions/examples/`} primaryLabel="Browse examples" secondaryHref={docs} secondaryLabel="Read the API" />
</BaseLayout>
