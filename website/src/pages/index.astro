---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import InstallCommand from '../components/InstallCommand.astro';
import ProductShot from '../components/ProductShot.astro';
import Section from '../components/Section.astro';
import { outcomes } from '../data/outcomes';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="pi-web"
  description="Give agents meaningful work, keep every thread understandable, and inspect rich results from any device with pi-web."
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <div class="hero__kicker">
          <img src={`${base}pi-mascot.png`} width="38" height="38" alt="" />
          <span>Local-first · browser-based · open source</span>
        </div>
        <h1>The best interface for working with your agents.</h1>
        <p class="hero__lede">Give agents meaningful work, keep every thread understandable, and inspect rich results from any device.</p>
        <InstallCommand />
        <div class="hero__actions">
          <ButtonLink href={`${base}getting-started/`}>Get started</ButtonLink>
          <ButtonLink href={`${base}features/`} variant="secondary">Explore features</ButtonLink>
          <a class="text-link" href="https://github.com/ashwin-pc/pi-web">View on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero__note">Requires Node.js 24+. Runs on your machine with your projects and credentials. Current harness: <code>pi</code>.</p>
      </div>
      <div class="hero__visual">
        <ProductShot />
      </div>
    </div>
  </section>

  <Section id="outcomes" eyebrow="Built around outcomes" title="Agents can do more than answer. Your interface should too." intro="pi-web keeps substantial work visible from the first prompt to the finished deliverable.">
    <div class="outcome-grid">
      {outcomes.map((outcome, index) => (
        <a class:list={['outcome-card', `outcome-card--${outcome.id}`]} id={outcome.id} href={`${base}${outcome.href}`} aria-label={`${outcome.eyebrow}: ${outcome.title}`}>
          <div class="outcome-card__top">
            <span class="outcome-card__number">0{index + 1}</span>
            <span class="status-dot"><i></i> Available now</span>
          </div>
          <p class="eyebrow">{outcome.eyebrow}</p>
          <h3>{outcome.title}</h3>
          <p>{outcome.description}</p>
          <ul aria-label={`${outcome.eyebrow} capabilities`}>
            {outcome.proof.map((item) => <li>{item}</li>)}
          </ul>
          <span class="outcome-card__link">Explore this outcome <i aria-hidden="true">→</i></span>
        </a>
      ))}
    </div>
  </Section>

  <Section tone="dark" eyebrow="Work, not just chat" title="Keep the whole effort in view." intro="The transcript is only one part of the job. pi-web holds the surrounding context so you can follow progress and use what the agent produces.">
    <div class="proof-strip">
      <div><span>01</span><strong>Give meaningful work</strong><p>Files and attachments enter the same focused workspace as your request.</p></div>
      <div><span>02</span><strong>Follow the effort</strong><p>Sessions, live tools, branches, and queued prompts make work inspectable.</p></div>
      <div><span>03</span><strong>Use the result</strong><p>Artifacts, rich previews, files, and diffs turn output into a handoff.</p></div>
    </div>
  </Section>

  <Section id="extensions" tone="tinted">
    <div class="split-feature">
      <div class="split-feature__copy">
        <p class="eyebrow">Make pi-web work your way</p>
        <h2>Describe the workflow. Ask your agent to add it.</h2>
        <p>Need a project decision log, a tailored action, or a panel for your team's process? An agent can create a typed pi-web extension as ordinary project code, reload it, and help you refine it in the same app.</p>
        <ol class="mini-flow">
          <li><span>Ask</span> Describe the workflow and point the agent to the extension docs.</li>
          <li><span>Build</span> Create a project-local TypeScript extension.</li>
          <li><span>Use</span> Reload resources and put the new UI to work.</li>
        </ol>
        <ButtonLink href={`${base}extensions/`} variant="secondary">Explore extensions</ButtonLink>
      </div>
      <div class="extension-panel" aria-hidden="true">
        <div class="extension-panel__head"><span><i></i> Project decision log</span><span class="extension-panel__add">＋ Add</span></div>
        <div class="decision-row"><span class="decision-row__status">Decided</span><div><strong>Launch narrative</strong><small>Owner · Maya</small></div><span>→</span></div>
        <div class="decision-row"><span class="decision-row__status decision-row__status--open">Open</span><div><strong>Rollout sequence</strong><small>Owner · Arun</small></div><span>→</span></div>
        <div class="extension-panel__foot"><code>.pi/web/extensions/decision-log.ts</code><span>Healthy</span></div>
      </div>
    </div>
  </Section>

  <Section id="principles" narrow>
    <div class="principle-grid">
      <article>
        <span class="principle-icon" aria-hidden="true">⌂</span>
        <p class="eyebrow">Local-first trust</p>
        <h2>Your machine. Your access boundary.</h2>
        <p>pi-web binds to localhost by default and keeps provider credentials server-side. Optional bearer-token access helps protect the app, while you remain responsible for transport and network controls when exposing it through Tailscale or a reverse proxy.</p>
        <ButtonLink href={`${base}getting-started/#remote-access`} variant="quiet">Read the access guidance</ButtonLink>
      </article>
      <article>
        <span class="principle-icon principle-icon--violet" aria-hidden="true">π</span>
        <p class="eyebrow">Current harness</p>
        <h2>Full capability today. Honest direction tomorrow.</h2>
        <p><code>pi</code> is pi-web's current default and full-capability reference harness. The session contract is being designed so additional harnesses can fit without flattening their differences or reducing what <code>pi</code> can do. Additional harnesses do not ship today.</p>
        <ButtonLink href={`${base}principles/`} variant="quiet">Read the principles and direction</ButtonLink>
      </article>
    </div>
  </Section>

  <section class="closing-cta">
    <div class="container closing-cta__inner">
      <div>
        <p class="eyebrow">Start where the work lives</p>
        <h2>Open a terminal in your working directory.</h2>
      </div>
      <ButtonLink href={`${base}getting-started/`}>Set up pi-web</ButtonLink>
    </div>
  </section>
</BaseLayout>
