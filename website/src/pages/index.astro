---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import InstallCommand from '../components/InstallCommand.astro';
import ProductStory from '../components/ProductStory.astro';
import Section from '../components/Section.astro';
import { outcomes } from '../data/outcomes';

const base = import.meta.env.BASE_URL;
const visualOutcomes = outcomes.filter((outcome) => outcome.screenshot);
---

<BaseLayout title="pi-web" description="Give agents meaningful work, keep every thread understandable, and inspect rich results from any device with pi-web.">
  <section class="home-hero">
    <div class="container home-hero__copy">
      <div class="home-hero__welcome">
        <video data-welcome-animation muted playsinline autoplay preload="auto" aria-hidden="true">
          <source src={`${base}generated/new-chat-loading.webm`} type='video/webm; codecs="vp8"' />
          <source src={`${base}generated/new-chat-loading.mp4`} type='video/mp4; codecs="avc1.64001e"' />
        </video>
      </div>
      <div class="hero__kicker"><span>Local-first · open source</span></div>
      <h1>The best interface for working with your agents.</h1>
      <p>Run meaningful work, keep every thread visible, and inspect the result.</p>
      <InstallCommand />
      <div class="hero__actions">
        <ButtonLink href={`${base}getting-started/`}>Get started</ButtonLink>
        <a class="text-link" href="https://github.com/ashwin-pc/pi-web">GitHub ↗</a>
      </div>
      <small>Node.js 24+ · runs on your machine · Current harness: pi</small>
    </div>
    <div class="container home-hero__shot">
      <ProductStory
        desktop="website-work-desktop.png"
        mobile="website-work-mobile.png"
        width={1440}
        height={1000}
        mobileWidth={1073}
        mobileHeight={2321}
        mobileAspectWidth={390}
        mobileAspectHeight={844}
        alt="A customer research session in pi-web producing a launch brief and visual artifact"
        caption="Customer research turned into a launch brief in the real pi-web interface."
        priority
      />
    </div>
  </section>

  <nav class="outcome-nav container" aria-label="Product outcomes">
    {outcomes.map((outcome) => <a href={`${base}${outcome.href}`}><span>{outcome.eyebrow}</span><strong>{outcome.title}</strong></a>)}
  </nav>

  <Section id="stories" eyebrow="See the product" title="The screenshots are the tour.">
    <div class="story-stack">
      {visualOutcomes.map((outcome) => outcome.screenshot && (
        <ProductStory
          desktop={outcome.screenshot.desktop}
          mobile={outcome.screenshot.mobile}
          width={outcome.screenshot.width}
          height={outcome.screenshot.height}
          mobileWidth={outcome.screenshot.mobileWidth}
          mobileHeight={outcome.screenshot.mobileHeight}
          mobileAspectWidth={outcome.screenshot.mobileAspectWidth}
          mobileAspectHeight={outcome.screenshot.mobileAspectHeight}
          alt={outcome.screenshot.alt}
          title={outcome.title}
          caption={outcome.screenshot.caption}
          href={`${base}${outcome.href}`}
          linkLabel={outcome.eyebrow}
        />
      ))}
    </div>
  </Section>

  <Section id="extensions" tone="dark" eyebrow="Make it yours" title="Ask → source → reload.">
    <div class="extension-showcase">
      <ProductStory
        desktop="website-extension-desktop.png"
        mobile="website-extension-mobile.png"
        width={1440}
        height={1000}
        mobileWidth={1073}
        mobileHeight={2321}
        mobileAspectWidth={390}
        mobileAspectHeight={844}
        alt="A launch decisions extension open in the real pi-web side panel"
        caption="A real extension contribution rendered inside pi-web."
        href="https://github.com/ashwin-pc/pi-web/blob/main/server/fixtures/websiteWorkflowExtension.ts"
        linkLabel="View extension source"
      />
      <div class="extension-workflow">
        <blockquote>“Read <code>docs/pi-web-extensions.md</code>. Add the project workflow I described.”</blockquote>
        <code>.pi/web/extensions/my-workflow.ts</code>
        <code>/reload</code>
        <ButtonLink href={`${base}extensions/`}>Build with extensions</ButtonLink>
      </div>
    </div>
  </Section>

  <Section narrow>
    <div class="principle-grid principle-grid--compact">
      <article><p class="eyebrow">Local-first</p><h2>Your machine. Your boundary.</h2><p>Localhost by default; you choose any wider network path.</p><ButtonLink href={`${base}getting-started/#remote-access`} variant="quiet">Access guidance</ButtonLink></article>
      <article><p class="eyebrow">Current harness</p><h2><code>pi</code>, fully supported today.</h2><p>Additional harnesses are direction, not shipping support.</p><ButtonLink href={`${base}principles/`} variant="quiet">Principles and direction</ButtonLink></article>
    </div>
  </Section>
</BaseLayout>

<script>
  const welcomeAnimation = document.querySelector<HTMLVideoElement>('[data-welcome-animation]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const syncWelcomeAnimation = () => {
    if (!welcomeAnimation) return;
    if (reducedMotion.matches) {
      welcomeAnimation.pause();
      welcomeAnimation.currentTime = 0;
      return;
    }
    if (welcomeAnimation.currentTime === 0) void welcomeAnimation.play().catch(() => undefined);
  };
  reducedMotion.addEventListener('change', syncWelcomeAnimation);
  syncWelcomeAnimation();
</script>
