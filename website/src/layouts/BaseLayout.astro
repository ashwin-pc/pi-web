---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import packageJson from '../../../package.json';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteName = 'pi-web';
const pageTitle = title === siteName ? 'pi-web — The best interface for working with your agents' : `${title} — pi-web`;
const socialTitle = title === siteName ? `pi-web v${packageJson.version} — The best interface for working with your agents` : `${title} — pi-web v${packageJson.version}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${import.meta.env.BASE_URL}social-preview.png`, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'pi-web',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Any operating system with Node.js and a modern browser',
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  downloadUrl: 'https://www.npmjs.com/package/@ashwin-pc/pi-web',
  license: 'https://opensource.org/license/mit',
  description: 'The best interface for working with your agents.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1714" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The pi welcome animation on pi-web’s dark background" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="The pi welcome animation on pi-web’s dark background" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
