{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@ashwin-pc/pi-web/extensions": [
        "./src/extensions.ts"
      ]
    }
  },
  "include": [
    "server.ts",
    "supervisor.ts",
    "vite.config.ts",
    "src/**/*.ts",
    ".pi/extensions/**/*.ts",
    "examples/**/*.ts"
  ]
}
